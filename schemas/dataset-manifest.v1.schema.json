{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-enhance.local/schemas/dataset-manifest.v1.schema.json",
  "title": "AgentEnhance dataset manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "version", "classification", "modalities", "authority", "splits", "digest"],
  "properties": {
    "schema_version": {"const": "dataset_manifest.v1"},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "version": {"type": "string", "minLength": 1},
    "classification": {"enum": ["synthetic_public", "public_external", "private_local"]},
    "modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["text", "code", "image", "audio", "video", "file"]}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable", "content_addressed", "source_policy"],
      "properties": {
        "immutable": {"const": true},
        "content_addressed": {"const": true},
        "source_policy": {"type": "string", "minLength": 1}
      }
    },
    "grouping_key": {"type": "string", "minLength": 1},
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "dev", "selection", "final"],
      "properties": {
        "train": {"$ref": "#/$defs/split"},
        "dev": {"$ref": "#/$defs/split"},
        "selection": {"$ref": "#/$defs/split"},
        "final": {"$ref": "#/$defs/split"}
      }
    },
    "license": {"type": ["string", "null"]},
    "consent_basis": {"type": ["string", "null"]},
    "content_root": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^(pending|sha256:[0-9a-f]{64})$"}
  },
  "$defs": {
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_count", "index_sha256"],
      "properties": {
        "episode_count": {"type": "integer", "minimum": 0},
        "index_sha256": {"type": "string", "pattern": "^(pending|[0-9a-f]{64})$"},
        "sealed": {"type": "boolean"}
      }
    }
  }
}
